        snapshots().reverse().forEach(function(s,i) { console.log(i + ': ' + s.takenAt + ' — ' + s.tabs.length + ' terminals'); });
        showNamedSnapshots(snapshots(true).reverse());
        return;
    }
    if (command !== 'list' && command !== 'restore') throw Error('Unknown command: ' + command);
    if (name !== undefined) {
        if (dry) return restore(namedSnapshot(name),true,true);
        return locked(function() { restore(namedSnapshot(name),false,true); },true);
    }
    if (command === 'list') {
        var automatic = snapshots();
        var preview = automatic.length ? select(automatic,epoch(),(read(state + '/restored-epoch.txt') || '').trim(),index) : null;
        var named = snapshots(true).reverse();
        if (preview || !named.length) show(preview);
        showNamedSnapshots(named);
        return;
    }
    var selected = select(snapshots(),epoch(),(read(state + '/restored-epoch.txt') || '').trim(),index);
    locked(function() { restore(selected,dry); });
}
